# Copy to .env.local and uncomment what you need. Neither is required for the default setup.

# Dev only: where the Vite proxy sends /api requests (default http://localhost:8000).
# VITE_API_TARGET=http://localhost:8000

# Build time: full backend URL when the frontend is hosted separately from the backend.
# Leave unset to use same-origin /api (Vite dev proxy or the Docker image).
# VITE_API_BASE_URL=https://your-backend.up.railway.app/api
