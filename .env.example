# Copy to .env (repo root) and fill in. Never commit .env.

# Speech to text: openai | browser
#   openai  -> OpenAI Whisper (needs OPENAI_API_KEY)
#   browser -> trust the transcript the frontend sends (Web Speech API), works offline
SPEECH_PROVIDER=browser

# Lecture sentence -> concept mapping, AI student phrasing and exam questions: mock | openai
#   mock -> synonym + misconception phrase matching, offline demo safety net
# Exam questions are always written by the model from the teacher's uploaded document.
LLM_PROVIDER=openai

# Notebook storage: sqlite | postgres
DB_PROVIDER=postgres
SQLITE_PATH=backend/data/reeta.db
AUDIO_DIR=backend/data/audio

# OpenAI (dev). OPENAI_BASE_URL points at any OpenAI-compatible API (e.g. Groq); leave it out for OpenAI itself.
OPENAI_API_KEY=
OPENAI_WHISPER_MODEL=whisper-1
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=gpt-4o-mini

# Fraction of Exam questions the AI student must get right to pass
PASS_THRESHOLD=1.0

# Uploaded notes limits (characters): per source, and all sources together in the prompt
MAX_SOURCE_CHARS=50000
MAX_NOTES_CHARS=60000

# PostgreSQL (used when DB_PROVIDER=postgres). The schema comes from Alembic: `cd backend && alembic upgrade head`
# (the Docker image does it on start).
#   e.g. Neon: postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# POSTGRES_URL also works and wins over DATABASE_URL.
DATABASE_URL=
