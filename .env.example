# Copy to .env (repo root) and fill in. Never commit .env.

# Speech to text: openai | browser | oci
#   openai  -> OpenAI Whisper (needs OPENAI_API_KEY)
#   browser -> trust the transcript the frontend sends (Web Speech API), works offline
#   oci     -> OCI Speech, Whisper model (stub, TODO)
SPEECH_PROVIDER=openai

# Lecture sentence -> concept mapping and AI student phrasing: mock | openai | oci
#   mock -> synonym + misconception phrase matching, offline demo safety net
LLM_PROVIDER=mock

# Live exam questions: llm (written by the model from the course notes) | fixed (QUESTION_FILE, in file order)
# Override per run: /exam/run?source=fixed or ?source=llm
QUESTION_SOURCE=llm
QUESTION_FILE=photosynthesis_questions.json
# fixed only: true picks random questions from the file each run, false asks the first ones in order
QUESTION_SHUFFLE=false

# Notebook storage: sqlite | oracle | postgres
DB_PROVIDER=sqlite
SQLITE_PATH=backend/data/reeta.db
# postgres: the schema comes from Alembic, run `alembic upgrade head` in backend/ (the Docker image does it on start)
#   e.g. Neon: postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL=
AUDIO_DIR=backend/data/audio
CONTENT_DIR=content

# Uploaded notes limits (characters): per source, and all sources together in the prompt
MAX_SOURCE_CHARS=50000
MAX_NOTES_CHARS=60000

# OpenAI (dev)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_WHISPER_MODEL=whisper-1

# Fraction of Exam questions the AI student must get right to pass
PASS_THRESHOLD=1.0

# OCI (later)
OCI_CONFIG_FILE=~/.oci/config
OCI_PROFILE=DEFAULT
OCI_REGION=us-chicago-1
OCI_COMPARTMENT_ID=
OCI_GENAI_MODEL_ID=
OCI_SPEECH_BUCKET=
OCI_SPEECH_NAMESPACE=

# Oracle Autonomous Database (used when DB_PROVIDER=oracle)
#   ORACLE_PASSWORD        the ADMIN password you set when creating the database
#   ORACLE_DSN             a service name from the wallet's tnsnames.ora, e.g. xxxx_low
#   ORACLE_WALLET_DIR      folder the wallet zip was extracted to (gitignored)
#   ORACLE_WALLET_PASSWORD the password you set when downloading the wallet
ORACLE_USER=ADMIN
ORACLE_PASSWORD=
ORACLE_DSN=
ORACLE_WALLET_DIR=backend/wallet
ORACLE_WALLET_PASSWORD=
