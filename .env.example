# Copy to .env (repo root) and fill in. Never commit .env.

# Speech to text: openai | browser | oci
#   openai  -> OpenAI Whisper (needs OPENAI_API_KEY)
#   browser -> trust the transcript the frontend sends (Web Speech API), works offline
#   oci     -> OCI Speech, Whisper model (stub, TODO)
SPEECH_PROVIDER=openai

# Lecture sentence -> concept mapping and AI student phrasing: mock | openai | oci
#   mock -> synonym + misconception phrase matching, offline demo safety net
LLM_PROVIDER=mock

# Notebook storage: sqlite | oracle
DB_PROVIDER=sqlite
SQLITE_PATH=backend/data/reeta.db
AUDIO_DIR=backend/data/audio

# OpenAI (dev)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_WHISPER_MODEL=whisper-1

# Fraction of Exam questions the AI student must get right to pass
PASS_THRESHOLD=1.0

# OCI (later)
OCI_CONFIG_FILE=~/.oci/config
OCI_PROFILE=DEFAULT
OCI_REGION=us-chicago-1
OCI_COMPARTMENT_ID=
OCI_GENAI_MODEL_ID=
OCI_SPEECH_BUCKET=
OCI_SPEECH_NAMESPACE=

# Oracle Autonomous Database (later)
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_DSN=
ORACLE_WALLET_DIR=
